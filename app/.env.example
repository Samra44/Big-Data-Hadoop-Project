# Copy to .env and edit for your environment
EARTHSCAPE_SECRET=change-this-secret-key
EARTHSCAPE_API_KEY=earthscape-demo-key
EARTHSCAPE_PORT=5000
EARTHSCAPE_DEBUG=1
EARTHSCAPE_HTTPS=0
EARTHSCAPE_RETRAIN_EVERY=5000
EARTHSCAPE_STREAM_INTERVAL=5
EARTHSCAPE_BACKUP_HOURS=24
EARTHSCAPE_BACKUP_KEEP=7
EARTHSCAPE_CV_FOLDS=4
EARTHSCAPE_N_JOBS=-1
# Optional notifications
EARTHSCAPE_SMTP_HOST=
EARTHSCAPE_SMTP_PORT=587
EARTHSCAPE_SMTP_USER=
EARTHSCAPE_SMTP_PASSWORD=
EARTHSCAPE_ALERT_EMAIL_TO=
EARTHSCAPE_WEBHOOK_URL=
